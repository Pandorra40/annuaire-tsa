# Copier vers .env pour le développement local (ne jamais committer .env).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=annuaire_tsa
DB_USER=
DB_PASSWORD=

# Hash bcrypt du mot de passe admin (format $2y$… ou $2a$…).
# Quotter la valeur si elle contient des $ (sinon le shell les interprète).
ADMIN_HASH=

# Optionnel — formulaire de contact
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optionnel — alertes admin (suggestions, signalements, échecs de login)
# PUSHBULLET_TOKEN=
