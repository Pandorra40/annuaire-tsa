# Redirections https annuaire-tsa.fr
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} !on
RewriteCond %{HTTP_HOST} ^(?:www\.)?annuaire-tsa\.fr(?:.*)$ [nc]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [redirect=301,L]

######### End Generated by Lwspanel #########

# ============================================================
# ANNUAIRE TSA — Configuration Apache / LWS
# Headers de sécurité HTTP
# ============================================================

# --- Désactive MultiViews (évite les boucles de redirection /livres ↔ /livres/) ---
Options -MultiViews -Indexes

# --- Types MIME explicites ---
AddType text/css .css
AddType application/javascript .js
AddType image/svg+xml .svg
AddType application/json .json
AddType font/woff2 .woff2

# --- Headers de sécurité ---
<IfModule mod_headers.c>

  # Politique de chargement des ressources
  # (api.iconify.design retiré : les icônes sont désormais embarquées dans le build)
  Header always unset Content-Security-Policy
  # frame-src : les lecteurs de /ressources/videos, et eux seuls. Ils ne sont créés
  # qu'après un clic du visiteur — img-src reste inchangé, les vignettes étant
  # dessinées localement plutôt que tirées de i.ytimg.com.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://www.annuaire-tsa.fr https://data.bnf.fr; font-src 'self'; worker-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none';"

  # Interdit le chargement dans une iframe (anti-clickjacking)
  Header always set X-Frame-Options "DENY"

  # Interdit au navigateur de deviner le type MIME
  Header always set X-Content-Type-Options "nosniff"

  # Ne transmet que l'origine (pas l'URL complète) aux sites externes
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Désactive les fonctionnalités navigateur inutilisées
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()"

  # Marqueur de version : permet de vérifier depuis l'extérieur quel .htaccess est actif
  Header always set X-TSA-Config "2026-08-04"

  # Supprime la signature du serveur
  Header always unset X-Powered-By
  Header always unset Server

</IfModule>

# --- Protection des fichiers sensibles ---
<FilesMatch "\.(env|log|sql|md|git)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# --- Interdire l'accès aux dossiers cachés ---
RedirectMatch 404 /\..*$

# --- Service worker : JAMAIS de cache long ---
# sw.js doit toujours être revalidé, sinon les mises à jour du site ne se
# propagent pas (le navigateur garde l'ancien SW qui sert l'ancien front).
<IfModule mod_headers.c>
  <FilesMatch "^(sw|registerSW|workbox-[a-z0-9]+)\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  # Empêche mod_expires de remettre un cache long sur le service worker
  <FilesMatch "^(sw|registerSW|workbox-[a-z0-9]+)\.js$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>

# --- Cache navigateur pour les ressources statiques ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# --- Compression GZIP ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain image/svg+xml application/json
</IfModule>

# --- Sitemap ---
# Sitemap: https://www.annuaire-tsa.fr/sitemap.xml

# --- Redirections anciennes URLs .html → nouvelles URLs Nuxt ---
Redirect 301 /apropos.html /apropos
Redirect 301 /contact.html /contact
Redirect 301 /mentions.html /mentions
Redirect 301 /suggerer.html /suggerer
Redirect 301 /fiche.html /
Redirect 301 /signaler.html /signaler
Redirect 301 /merci.html /
Redirect 301 /livres/suggerer.html /ressources/livres/suggerer
Redirect 301 /admin/login.html /admin/login
# Pas de redirection pour /admin/index.html : c'est le fichier réellement généré par
# Nuxt, et la règle se déclenchait sur l'index servi pour /admin/ — d'où une boucle
# infinie /admin ⇄ /admin/. L'ancienne URL fonctionne telle quelle.
Redirect 301 /admin/modifier.html /admin/modifier
Redirect 301 /admin/livres.html /admin/livres

# --- Livres TSA déplacé sous Ressources (9 août 2026) ---
# /livres est indexée depuis mai et figure au sitemap : la 301 transfère le
# référencement acquis. L'ordre compte — la règle la plus spécifique d'abord,
# sans quoi /livres/suggerer serait avalé par la redirection de /livres.
Redirect 301 /livres/suggerer /ressources/livres/suggerer
Redirect 301 /livres /ressources/livres

# --- Routing Nuxt (SPA fallback) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Normalise les rubriques sans slash → avec slash, le prérendu produisant des
  # dossiers. /livres est traité plus haut par une redirection définitive.
  RewriteRule ^ressources/(livres|videos)$ /ressources/$1/ [R=301,L]
  # Un dossier réel mais sans index (ex : /praticien/, /departement/) doit répondre 404
  # avec la page d'erreur du site, et non le « Forbidden » d'Apache.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/_nuxt/
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/admin/
  RewriteCond %{REQUEST_URI} !\.(php|html|json|js|css|svg|png|jpg|ico|txt|xml|woff2)$
  RewriteRule ^(.*)$ /200.html [L]
</IfModule>

# --- Page d'erreur personnalisée ---
ErrorDocument 404 /404.html

# --- Mode maintenance (décommenter les 3 lignes pour activer) ---
# RewriteCond %{REQUEST_URI} !^/maintenance\.html$
# RewriteCond %{REQUEST_URI} !^/css/
# RewriteCond %{REQUEST_URI} !^/img/
# RewriteRule ^(.*)$ /maintenance.html [R=302,L]
